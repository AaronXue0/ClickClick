    atlasWidth: 2048
    atlasHeight: 2048
    characterSetSelectionMode: 7
    characterSequence: "\u6B61\u8FCE\u849E\u81E8\u8A2D\u8A08\u8207\u591A\u5A92\u9AD4\u9818\u57DF\u7684\u65B0\u578B\u6C34\u65CF\u9928\uFF01\n\u55AE\n\u592A\u597D\u4E86\uFF0C\u6700\u5F8C\u518D\u8B93\u6211\u4F86\u8AAA\u660E\u8A08\u5206\u6A5F\u5236\u5427\uFF01\n\u6BCF\u4FEE\u5FA9\u4E00\u500B\u9375\u5E3D\u53EF\u4EE5\u62EF\u6551\u751F\u7269\u4E4B\u5916\u9084\u80FD\u7372\u5F97100\u5206\n\u9023\u7E8C\u6D88\u9664\u53EF\u4EE5\u7372\u5F97\u8F03\u597D\u7684\u7E3E\u6548\n\u5206\u5225\u662Fx1,
      x2, x3, \u6700\u9AD84\u500D\n\u8A66\u8457\u6311\u6230\u770B\u770B12000\u5206\uFF0C\u7372\u5F97\u795E\u79D8\u7684\u5C0F\u79AE\u7269\u5427\uFF01\u9996\u5148\u4F38\u51FA\u53F3\u624B\u4F86\u9032\u884C\u64CD\u4F5C\n\u4EE5\u4E0A\u662F\u9700\u8981\u4FEE\u5FA9\u7684\u9375\u5E3D\u4EE5\u53CA\u5C0D\u61C9\u7684\u5DE5\u5177\uFF01\n\u300C\u6E96\u5099\u958B\u59CB\u4FEE\u5FA9\u5DE5\u4F5C\u56C9\uFF5E\u300D\n\u9019\u908A\u6703\u4E00\u6B65\u4E00\u6B65\u6559\u4F60\u4F7F\u7528\u4E09\u7A2E\u5DE5\u5177\uFF0C\u5404\u6709\u4E0D\u540C\u7528\u9014\u3002\n\u300C\u53F3\u624B\u300D\u6BD4\u51FA\u526A\u5200,
      \u77F3\u982D, \u5E03\u4F86\u5207\u63DB\u4E0D\u540C\u7684\u5DE5\u5177\u8A66\u8A66\u770B\u6211\u53EB\u505A\u6416\u687F\u6C34\u6BCD\uFF0C\u662F\u9019\u6B21\u7684\u5C0E\u89BD\u54E1\n\u4ECA\u5929\u6211\u5011\u8981\u9AD4\u9A57\u8A2D\u8A08\u5E2B\u5011\\n\u662F\u5982\u4F55\u7D93\u71DF\u6C34\u65CF\u9928\u7684\n\u90A3\u9EBC\u8A71\u4E0D\u591A\u8AAA\uFF0C\u9996\u5148\u6311\u9078\u4E00\u4F4D\u8A2D\u8A08\u5E2B\\n\u4F5C\u70BA\u9AD4\u9A57\u9019\u6B21\u7684\u5C0E\u5E2B\u5427\n\u63EE\u63EE\u624B\uFF0C\u548C\u4F60\u60F3\u8981\u7684\u5C0E\u5E2B\u6253\u8072\u62DB\u547C\n\u5728\u5DE5\u4F5C\u958B\u59CB\u4E4B\u524D\uFF0C\u8B93\u6211\u5011\u5148\u62CD\u4E00\u5F35\u54E1\u5DE5\u8B49\u5427\u5F85\u6703\u53EA\u8981\u6BD4\u51FA\"
      Ya \"\uFF0C\u76F8\u6A5F\u5C31\u6703\u81EA\u52D5\u555F\u52D5\u56C9\n\u62CD\u51FA\u4E00\u5F35\u7F8E\u7F8E\u7684\u7167\u7247\u518D\u958B\u59CB\u4ECA\u5929\u7684\u9AD4\u9A57\u5427\n\u7D50\u675F\u7684\u6642\u5019\uFF0C\u4E0D\u8981\u592A\u5FEB\u96E2\u958B\uFF0C\u6211\u5011\u6703\u628A\u9019\u5F35\u7167\u7247\u50B3\u7D66\u4F60\u6B50\u300C\u548C\u4F60\u60F3\u8981\u9078\u7684\u5C0E\u5E2B\u63EE\u63EE\u624B\uFF0C\u6253\u8072\u62DB\u547C\u300D\n\u8A66\u8457\u53F3\u624B\u64FA\u51FA\u526A\u5200\u7684\u624B\u52E2\u770B\u770B\n\u4E5F\u592A\u68D2\u4E86\uFF01\u63A5\u8457\u53F3\u624B\u64FA\u51FA\u77F3\u982D\u7684\u624B\u52E2\n\u6700\u5F8C\u4E00\u500B\u5DE5\u5177\u4E86\uFF0C\u53F3\u624B\u64FA\u51FA\u5E03\u7684\u624B\u52E2\n\u53EF\u7ACB\u53EF\u5167\u7684\u7BA1\u7DDA\u7A81\u7136\u7206\u70B8\u6F0F\u6C34\u4E86\uFF01\n\u8EAB\u70BA\u98FC\u80B2\u54E1\u7684\u4F60\u5F97\u76E1\u5FEB\u8DDF\u8457\u751F\u7269\u5011\u628A\u9375\u5E3D\u4FEE\u597D\uFF01\n\u8D95\u7DCA\u4F86\u6311\u9078\u4E00\u500B\u751F\u7269\u4F5C\u70BA\u4F60\u7684\u5925\u4F34\u5427\uFF01\n\u300C\u6E96\u5099\u958B\u59CB\u4FEE\u5FA9\u6559\u5B78\u56C9\uFF5E\u300D\n\u9019\u908A\u6703\u4E00\u6B65\u4E00\u6B65\u6559\u4F60\u4F7F\u7528\u4E09\u7A2E\u5DE5\u5177\uFF0C\u5404\u6709\u4E0D\u540C\u7528\u9014\u3002\n\u300C\u53F3\u624B\u300D\u6BD4\u51FA\u526A\u5200,
      \u77F3\u982D, \u5E03\u4F86\u5207\u63DB\u4E0D\u540C\u7684\u5DE5\u5177\u8A66\u8A66\u770B\n\u8A66\u8457\u53F3\u624B\u64FA\u51FA\u526A\u5200\u7684\u624B\u52E2\u770B\u770B\n\u4E5F\u592A\u68D2\u4E86\uFF01\u63A5\u8457\u53F3\u624B\u64FA\u51FA\u77F3\u982D\u7684\u624B\u52E2\n\u6700\u5F8C\u4E00\u500B\u5DE5\u5177\u4E86\uFF0C\u53F3\u624B\u64FA\u51FA\u5E03\u7684\u624B\u52E2\n\u73FE\u5728\u8A66\u8457\u5FA9\u539F\u6BCF\u4E00\u500B\u9375\u5E3D\u770B\u770B\uFF01\n\u592A\u597D\u4E86\uFF0C\u6700\u5F8C\u518D\u8B93\u6211\u4F86\u8AAA\u660E\u8A08\u5206\u6A5F\u5236\u5427\uFF01\n\u9023\u7E8C\u6D88\u9664\u53EF\u4EE5\u7372\u5F97\u8F03\u597D\u7684\u7E3E\u6548\n\u5206\u5225\u662Fx1,
      x2, x3, \u6700\u9AD84\u500D\n\u90A3\u9EBC\u518D\u8907\u7FD2\u4E00\u4E0B\uFF0C\u6E96\u5099\u597D\u5C31\u958B\u59CB\u5427\uFF01\u9078\u64C7\u5B8C\u7562\uFF0C\u6BD4\u51FA
      Ya \u78BA\u8A8D\u533F\u540D\u982D\u50CF\u9810\u89BD\nBug\u7AE0\u9B5A\u96FB\u8DEF\u73CA\u745A\u96FB\u8DEF\u73CA\u745A\u5E95\u7247\u87F9\u92FC\u7B46\u70CF\u8CCA\u6416\u687F\u6C34\u6BCD\u93E1\u982D\u87F9\u96FB\u7E6A\u9B5F\u533F\u540D(\u4E0D\u9732\u81C9)\u7A0B\u5F0F\u82B1\u5712\u9C3B\u7E3D\u5206\uFF1AABCDFGHIJKLMNOPQRSTUVWXYZ\nabcdefghijklmnopqrstuvwxyz\n0123456789\n!\u201D#$%&\u2019()*+,-./:;<=>?@[]^_`{|}~\n\u7E3D\u5206\u6578\u6B63\u5728\u751F\u6210QRCODEE\n\u6392\u884C\u699C\u96D9\u624B\u6BD4
      Ya \u7167\u5F35\u76F8\u5427\u982D\u50CF\u9810\u89BD\nBug\u7AE0\u9B5A\u96FB\u8DEF\u73CA\u745A\u96FB\u8DEF\u73CA\u745A\u5E95\u7247\u87F9\u92FC\u7B46\u70CF\u8CCA\u6416\u687F\u6C34\u6BCD\u93E1\u982D\u87F9\u96FB\u7E6A\u9B5F\u533F\u540D(\u4E0D\u9732\u81C9)\u7A0B\u5F0F\u82B1\u5712\u9C3B\n\u9078\u64C7\u5B8C\u7562\uFF0C\u6BD4\u51FA
