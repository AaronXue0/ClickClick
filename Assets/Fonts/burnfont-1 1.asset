    characterSetSelectionMode: 7
    characterSequence: "1.\u57FA\u672C\u64CD\u4F5C\u3002\n\u53F3\u624B: \u6BD4\u51FA\u526A\u5200\u77F3\u982D\u5E03\u7684\u624B\u52E2\n\u5DE6\u624B:
      \u79FB\u52D5\u5230\u5C0D\u61C9\u7684\u9375\u5E3D\n\n2.\u5DE5\u5177\u89E3\u8AAA\u3002\n\u526A\u5200(\u4EE3\u8868)=\u6C34\u8349\u593E\n\u77F3\u982D(\u4EE3\u8868)=\u9020\u666F\u5EFA\u6750\n\u5E03(\u4EE3\u8868)=\u9632\u6F0F\u6C34\u81A0\u5E36\n\u7576\u9375\u5E3D\u51FA\u73FE\u5C0D\u61C9\u7684\u640D\u58DE\u72C0\u614B\uFF0C\u6BD4\u51FA\u526A\u5200\u77F3\u982D\u5E03\u4FEE\u597D\n\n3.\u4FEE\u597D1\u500B\u9375\u5E3D\u7372\u5F97100\u5206\u3002\n<color=red>\u82E5\u9023\u7E8C\u4FEE\u597D\u5169\u500B\u9375\u5E3D.</color>\n\u7B2C2\u500B\u7684\u5206\u6578x1.5\u500D\u21922\u500D\u21923\u500D\uFF0C\u6700\u9AD83\u500D\u70BA\u6B62\u3002\n\nAssets/Fonts/\n\n\u63EE\u63EE\u624B\uFF0C\u548C\u4F60\u60F3\u8981\u7684\u5C0E\u5E2B\u6253\u8072\u62DB\u547C\n\u6211\u53EB\u505A\u6416\u687F\u6C34\u6BCD\uFF0C\u662F\u9019\u6B21\u7684\u5C0E\u89BD\u54E1\n\u4ECA\u5929\u6211\u5011\u8981\u9AD4\u9A57\u8A2D\u8A08\u5E2B\u5011\\n\u662F\u5982\u4F55\u7D93\u71DF\u6C34\u65CF\u9928\u7684\n\u90A3\u9EBC\u8A71\u4E0D\u591A\u8AAA\uFF0C\u9996\u5148\u6311\u9078\u4E00\u672A\u8A2D\u8A08\u5E2B\\n\u4F5C\u70BA\u9AD4\u9A57\u9019\u6B21\u7684\u5C0E\u5E2B\u5427\uFF01\n\u63EE\u63EE\u624B\uFF0C\u548C\u4F60\u60F3\u8981\u7684\u5C0E\u5E2B\u6253\u8072\u62DB\u547C"
